%% docs/architecture-pipeline.mmd — Pipeline Flow
%% The logical order from commit to running application, and the hard
%% boundary between CI and CD.
flowchart TB

    PUSH(["git push to main"])
    PRQ(["pull request opened"])
    HOOK{{"GitHub webhook"}}
    PUSH --> HOOK
    PRQ --> HOOK

    HOOK -->|pull request| PRGATE["<b>PR build</b> — same Jenkinsfile, gated<br/>runs validate · lint · test · build · scan<br/><b>Push and Trigger CD are SKIPPED</b><br/>an unapproved PR can never reach the registry"]

    HOOK -->|push to main| CI

    subgraph CI["application-ci &nbsp;—&nbsp; Jenkinsfile-ci &nbsp;—&nbsp; SA jenkins-agent-ci &nbsp;—&nbsp; <b>CANNOT DEPLOY</b>"]
        C1["<b>1-2 &nbsp; Checkout and validate</b><br/>git short SHA becomes the image tag<br/>hadolint x4 · shellcheck · helm lint · helm template"]
        C2["<b>3-4 &nbsp; Lint and test</b><br/>flake8 · pytest<br/>results published to Jenkins as JUnit"]
        C3["<b>5-6 &nbsp; Build and scan</b><br/>BuildKit rootless x3 → local OCI tarball<br/>Trivy: CycloneDX SBOM + CRITICAL gate<br/><i>nothing has been pushed yet</i>"]
        C4["<b>7-9 &nbsp; Push and record</b><br/>ECR login via IRSA (RAM-only token)<br/>push x3, tag = git SHA, digest captured<br/>image-manifest.json archived"]
        C1 --> C2 --> C3 --> C4
    end

    REG[("<b>ECR</b><br/>vm-order-*:&lt;git-sha&gt;<br/>IMMUTABLE tags")]
    C4 --> REG

    HANDOFF{{"<b>hand-off</b> — build job: application-cd<br/>IMAGE_TAG · 3 digests · CI build number · commit SHA"}}
    C4 --> HANDOFF

    subgraph CD["application-cd &nbsp;—&nbsp; Jenkinsfile-cd &nbsp;—&nbsp; SA jenkins-agent-cd &nbsp;—&nbsp; <b>CANNOT BUILD</b>"]
        D1["<b>1-3 &nbsp; Validate the request</b><br/>reject empty · reject 'latest' · must match a git SHA<br/>verify the tag exists in ECR (read-only)<br/>helm lint + server-side dry run"]
        D2["<b>4 &nbsp; APPROVAL</b><br/>a human clicks Deploy<br/>Jenkins records who, what version, which namespace"]
        D3["<b>5-6 &nbsp; Deploy and roll out</b><br/>helm upgrade --install x3 --wait<br/>kubectl rollout status x3"]
        D4["<b>7-9 &nbsp; Verify</b><br/>running image == requested tag<br/>smoke test: /healthz · /api/health · public ALB<br/>deployment record → S3"]
        D1 --> D2 --> D3 --> D4
    end

    HANDOFF --> D1
    REG -.->|"the same artifact CI scanned — never rebuilt"| D3

    FAILCI["<b>CI FAILED</b><br/>nothing pushed to the registry<br/>application-cd never triggered<br/>SNS notification sent"]
    C2 -.->|a test fails| FAILCI
    C3 -.->|CRITICAL vulnerability| FAILCI

    FAILCD["<b>ROLLBACK</b><br/>collect events and pod logs <i>first</i><br/>then helm rollback x3<br/>build FAILED · SNS notification"]
    D4 -.->|rollout or smoke test fails| FAILCD

    LIVE(["<b>Application live in devops-app</b><br/>fully traceable:<br/>CD build → CI build → commit → image digest"])
    D4 --> LIVE

    classDef ci fill:#e3f0ff,stroke:#2563a8,stroke-width:1.5px
    classDef cd fill:#e6f7ee,stroke:#1d7a4c,stroke-width:1.5px
    classDef bad fill:#ffe5e5,stroke:#c0392b,stroke-width:2px
    classDef good fill:#d4f4dd,stroke:#1d7a4c,stroke-width:3px
    classDef gate fill:#fff6d6,stroke:#b8860b,stroke-width:2px
    classDef store fill:#f3ecff,stroke:#6b3fa0,stroke-width:2px

    class C1,C2,C3,C4 ci
    class D1,D3,D4 cd
    class FAILCI,FAILCD,PRGATE bad
    class LIVE good
    class D2,HANDOFF,HOOK gate
    class REG store
