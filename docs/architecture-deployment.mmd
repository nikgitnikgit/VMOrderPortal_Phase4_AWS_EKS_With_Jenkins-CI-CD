%% docs/architecture-deployment.mmd — Deployment View
%% What runs where, what is exposed, and which identity holds which permission.
flowchart TB

    DEV(["Developer"])
    GH["GitHub<br/>repository + webhook"]
    USR(["End user"])

    DEV -->|git push| GH

    subgraph PUB["PUBLIC SUBNETS"]
        ALBJ["<b>ALB — Jenkins</b><br/>HTTPS 443, ACM certificate<br/>inbound-cidrs = your IP /32"]
        ALBA["<b>ALB — application</b><br/>HTTPS 443, ACM certificate<br/>HTTP 80 → 443 redirect"]
    end

    GH -.->|webhook| ALBJ
    USR --> ALBA

    subgraph JN["EKS node group: jenkins-nodes — 1 x m7i-flex.large — TAINTED role=jenkins"]
        JC["<b>jenkins-0</b> · controller<br/>numExecutors = 0<br/>SA: jenkins"]
        PVC[("PVC 8Gi<br/>EBS gp2")]
        ACI["<b>CI agent pod</b> · ephemeral<br/>tools · buildkit · trivy<br/>SA: jenkins-agent-ci<br/><i>no deploy permission</i>"]
        ACD["<b>CD agent pod</b> · ephemeral<br/>tools only, no builder<br/>SA: jenkins-agent-cd<br/><i>no push permission</i>"]
    end

    subgraph AN["EKS node group: app-nodes — 3 x t3.small — namespace devops-app"]
        FE["<b>frontend</b> x2<br/>nginx :8080"]
        BE["<b>backend</b> x2<br/>Flask :5000"]
        WK["<b>worker</b> x2<br/>Flask :5001"]
        SEC[["<b>Secret: app-secrets</b><br/>DB password<br/>Jenkins cannot read this"]]
    end

    subgraph AWS["AWS MANAGED SERVICES"]
        ECR[("ECR · 4 repositories<br/>IMMUTABLE tags")]
        S3[("S3<br/>orders / builds / deployments")]
        RDS[("RDS PostgreSQL<br/>DB subnets, no internet route")]
        MSG["SNS + SES"]
    end

    ALBJ --> JC
    JC --- PVC
    JC ==>|creates, deletes| ACI
    JC ==>|creates, deletes| ACD

    ACI ==>|"push images (IRSA)"| ECR
    ACD -->|"verify tag (read-only)"| ECR
    ACD ==>|helm upgrade| FE

    ALBA --> FE
    FE -->|proxy /api/| BE
    BE -->|notify| WK
    BE --> SEC
    BE --> RDS
    WK --> MSG
    ACI --> S3

    classDef exposed fill:#ffe5e5,stroke:#c0392b,stroke-width:2px
    classDef jenkins fill:#e3f0ff,stroke:#2563a8,stroke-width:2px
    classDef app fill:#e6f7ee,stroke:#1d7a4c,stroke-width:2px
    classDef store fill:#f3ecff,stroke:#6b3fa0,stroke-width:2px
    classDef secret fill:#fff6d6,stroke:#b8860b,stroke-width:3px
    classDef ext fill:#f2f2f2,stroke:#666,stroke-width:1px

    class ALBJ,ALBA exposed
    class JC,PVC,ACI,ACD jenkins
    class FE,BE,WK app
    class ECR,S3,RDS,MSG store
    class SEC secret
    class DEV,GH,USR ext
