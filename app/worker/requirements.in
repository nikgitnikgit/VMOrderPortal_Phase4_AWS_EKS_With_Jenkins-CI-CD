# REVIEW FIX 4.3 — this file is the human-edited input; requirements.txt is
# generated from it and carries every transitive dependency with a sha256 hash.
#
# To change a dependency, edit THIS file and regenerate:
#     pip install pip-tools
#     pip-compile --generate-hashes --allow-unsafe \
#         --output-file app/worker/requirements.txt app/worker/requirements.in
#
